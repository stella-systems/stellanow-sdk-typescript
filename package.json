  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts,tsx,json,md}' 'tests/**/*.{ts,tsx}'"
  },
  "keywords": [
    "typescript",
    "library"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/stella-systems/stellanow-sdk-typescript"
  },
  "bugs": {
    "url": "https://github.com/stella-systems/stellanow-sdk-typescript/issues"
  },
  "homepage": "https://github.com/stella-systems/stellanow-sdk-typescript#readme",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.5"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "mqtt": "^5.14.1",
    "nanoid": "^5.1.6",
    "openid-client": "^6.8.1"
  }
}
